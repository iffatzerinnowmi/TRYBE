          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Doctor Demo 3\",\n    \"email\": \"demo.researcher3@trybe.test\",\n    \"phone\": \"01790003003\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\",\n    \"role\": \"researcher\",\n    \"location\": \"Dhaka, Bangladesh\"\n}",
