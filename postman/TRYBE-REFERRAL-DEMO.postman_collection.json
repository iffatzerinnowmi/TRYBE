          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "trybe_ref={{refCode}}"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:1048/api/v1/auth/register",
          "protocol": "http",
          "host": [
