        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Doctor Demo 2\",\n    \"email\": \"demo.researcher2@trybe.test\",\n    \"phone\": \"01790002002\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\",\n    \"role\": \"researcher\",\n    \"location\": \"Dhaka, Bangladesh\"\n}",
          "options": {
            "raw": {
